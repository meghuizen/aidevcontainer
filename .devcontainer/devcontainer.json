{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  // Docker (Docker Desktop / Docker Engine). For rootless podman use
  // .devcontainer/podman/devcontainer.json instead.
  // Extensions, ports, remoteUser and postCreateCommand come from the image's
  // `devcontainer.metadata` label (see Dockerfile) — keep this file thin.
  "name": "ai-dev (docker)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  // The data folder (all repos) is mounted at /data — see docker-compose.yml.
  "workspaceFolder": "/data/${localWorkspaceFolderBasename}"
}
